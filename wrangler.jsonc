{
  // Slush Sisters — static site served by Cloudflare Workers Static Assets.
  //
  // `name` MUST match the Worker that currently serves slushsisters.com, or a
  // deploy will create a second Worker and leave the live site untouched.
  // See docs/hosting.md for how to confirm this before the first deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drop-b4ff8c50-e5c",
  "compatibility_date": "2026-08-01",
  // Edge Worker in front of the static site. It logs every request to Analytics
  // Engine (crawler/traffic/leak visibility) and serves markdown to AI agents
  // that ask for it. See src/worker.js — it hands normal requests straight back
  // to the assets below, so serving behavior is unchanged.
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    // Lets src/worker.js serve assets via env.ASSETS.fetch(request).
    "binding": "ASSETS",
    // Run the Worker on every request (so it can log) before assets are served.
    "run_worker_first": true,
    // Serves /about for public/about.html and 307s /about.html -> /about.
    // This matches what production does today.
    "html_handling": "auto-trailing-slash",
    // Production currently returns index.html with a 200 for every unknown
    // path, which makes typos and dead links look like real pages to Google.
    // "404-page" serves public/404.html with a real 404 status instead.
    "not_found_handling": "404-page"
  },
  // Server-side request log (crawler/traffic/leak visibility) — TEMPORARILY OFF.
  // Adding the TRAFFIC binding below blocks `wrangler deploy` with error 10089
  // until Analytics Engine is enabled once on the account:
  //   Cloudflare dashboard -> Workers & Pages -> Analytics Engine -> Enable
  //   (https://dash.cloudflare.com/e1c0408b82c4364eb726c9c040aa85dd/workers/analytics-engine)
  // src/worker.js already no-ops its logging when this binding is absent, so
  // serving and markdown-for-agents are unaffected. Re-add to turn logging on:
  //   "analytics_engine_datasets": [
  //     { "binding": "TRAFFIC", "dataset": "slush_traffic" }
  //   ]

  // Booking email (POST /api/book -> business inbox via Email Routing) — ON.
  // Email Routing is enabled and mark@markbarrera.com is verified as the
  // destination, so this binding deploys cleanly and the /api/book handler in
  // src/worker.js sends each booking to that inbox. destination_address locks
  // the Worker to that one address — it can email nowhere else. Sending to a
  // verified destination is free on any plan. Full detail: docs/booking-worker.md.
  // Paired with BOOKING_ENDPOINT = '/api/book' in public/book.html.
  "send_email": [
    { "name": "BOOKING_EMAIL", "destination_address": "mark@markbarrera.com" }
  ]
}
